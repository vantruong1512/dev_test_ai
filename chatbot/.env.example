# ==================== LLM CONFIGURATION ====================
# Primary LLM Provider
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:27b
LLM_TIMEOUT_SECONDS=180

# ==================== DATABASE ====================
# SQLite (Development)
DATABASE_URL=sqlite:///./data/chatbot.db

# PostgreSQL (Production - uncomment nếu dùng)
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# ==================== CLOUD LLM API KEYS (Optional) ====================
# Groq (Fallback provider)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek (Alternative provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==================== INTEGRATION (Optional) ====================
# Facebook Messenger
FACEBOOK_PAGE_TOKEN=your_facebook_page_token_here
FACEBOOK_VERIFY_TOKEN=your_verify_token_here

# Zalo OA
ZALO_OA_ID=your_zalo_oa_id_here
ZALO_OA_SECRET=your_zalo_secret_here
ZALO_ACCESS_TOKEN=your_zalo_access_token_here

# ==================== RAG CONFIGURATION ====================
# Context limits (chars)
MAX_CHARS_PER_FILE=8000
MAX_TOTAL_CONTEXT=20000

# ==================== SERVER CONFIGURATION ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG_MODE=True

# ==================== SECURITY ====================
# JWT Secret (generate với: openssl rand -hex 32)
JWT_SECRET=your_secret_key_here_generate_with_openssl_rand_hex_32

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/chatbot.log

# ==================== RATE LIMITING ====================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=20

# ==================== BACKUP ====================
BACKUP_ENABLED=True
BACKUP_HOUR=2
BACKUP_DIR=./backups
